  letter-spacing: 2px;
}
.subtitle {
  color: #d1d5db;
  margin-bottom: 20px;
}
.card {
  background: rgba(255,255,255,0.1);
  padding: 20px;
  border-radius: 20px;
  margin-bottom: 18px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.3);
}
input {
  width: 100%;
  padding: 15px;
  border: none;
  border-radius: 10px;
  font-size: 17px;
  margin-bottom: 12px;
}
button {
  width: 100%;
  padding: 15px;
  border: none;
  border-radius: 10px;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  background: #facc15;
  color: #111827;
  margin-top: 8px;
}
button:hover {
  opacity: 0.9;
}
.wallet {
  font-size: 20px;
  font-weight: bold;
}
.bingo-title {
  font-size: 25px;
  margin-bottom: 10px;
}
.bingo-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 6px;
  max-width: 420px;
  margin: auto;
}
.header {
  background: #facc15;
  color: #111827;
  font-weight: bold;
}
.cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  color: #111827;
  border-radius: 8px;
  font-size: 19px;
  font-weight: bold;
  cursor: pointer;
}
.cell.selected {
  background: #22c55e;
  color: white;
}
.free {
  background: #a855f7;
  color: white;
  cursor: default;
}
.called {
