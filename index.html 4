* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #111827, #312e81);
  color: white;
  min-height: 100vh;
  text-align: center;
}
.container {
  width: 94%;
  max-width: 500px;
  margin: auto;
  padding: 20px 10px 40px;
}
h1 {
  margin-top: 10px;
