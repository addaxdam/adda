<body>
<header><div class="logo">👑 ELUZA BINGO</div><div class="tag">Play • Win • Be Lucky</div></header>
<main class="wrap">
<section class="hero">
<h1>ELUZA Bingo</h1>
<p>Play the demo game and test your bingo card.</p>
<button onclick="newGame()">Play Now</button>
</section>
<section class="card">
<div class="stats">
<div class="stat">Players<br><b id="players">248</b></div>
<div class="stat">Prize Pool<br><b>1,000 ETB</b></div>
<div class="stat">Balance<br><b>500 ETB (Demo)</b></div>
</div>
</section>
<section class="card">
<h2>🎟️ Your Bingo Card</h2>
<div class="board" id="board"></div>
<div class="controls" style="margin-top:18px">
<div>Current Ball<br><span id="ball">—</span></div>
<button onclick="callBall()">Call Next Ball</button>
<button onclick="newGame()">New Game</button>
<div class="container">
  <h1>👑 ELUZA BINGO</h1>
  <div class="subtitle">Play Bingo • Have Fun • Win</div>
  <!-- LOGIN -->
  <div class="card" id="loginBox">
    <h2>Player Login</h2>
    <input
      type="text"
      id="playerName"
      placeholder="Enter your player name"
    >
    <button onclick="startGame()">
      CONTINUE
    </button>
  </div>
  <!-- GAME -->
  <div id="gameBox" class="hidden">
    <div class="card">
      <h2 id="welcome"></h2>
      <div class="wallet">
        💰 Demo Balance: <span id="balance">100</span> ETB
      </div>
    </div>
    <div class="card">
      <div class="bingo-title">Your Bingo Card</div>
      <div class="bingo-grid">
        <div class="cell header">B</div>
        <div class="cell header">I</div>
        <div class="cell header">N</div>
        <div class="cell header">G</div>
        <div class="cell header">O</div>
        <div class="cell" onclick="selectCell(this)">7</div>
        <div class="cell" onclick="selectCell(this)">19</div>
        <div class="cell" onclick="selectCell(this)">33</div>
        <div class="cell" onclick="selectCell(this)">48</div>
        <div class="cell" onclick="selectCell(this)">62</div>
        <div class="cell" onclick="selectCell(this)">3</div>
        <div class="cell" onclick="selectCell(this)">22</div>
        <div class="cell" onclick="selectCell(this)">39</div>
        <div class="cell" onclick="selectCell(this)">51</div>
        <div class="cell" onclick="selectCell(this)">70</div>
        <div class="cell" onclick="selectCell(this)">12</div>
        <div class="cell" onclick="selectCell(this)">28</div>
        <div class="cell free">FREE</div>
        <div class="cell" onclick="selectCell(this)">57</div>
        <div class="cell" onclick="selectCell(this)">66</div>
        <div class="cell" onclick="selectCell(this)">15</div>
        <div class="cell" onclick="selectCell(this)">25</div>
        <div class="cell" onclick="selectCell(this)">42</div>
        <div class="cell" onclick="selectCell(this)">53</div>
        <div class="cell" onclick="selectCell(this)">74</div>
        <div class="cell" onclick="selectCell(this)">9</div>
        <div class="cell" onclick="selectCell(this)">17</div>
        <div class="cell" onclick="selectCell(this)">35</div>
        <div class="cell" onclick="selectCell(this)">59</div>
        <div class="cell" onclick="selectCell(this)">68</div>
      </div>
      <button onclick="callNumber()">
        🎱 CALL NUMBER
      </button>
      <div class="called">
        Called: <span id="calledNumber">-</span>
      </div>
      <div class="status" id="status">
        Press CALL NUMBER to start.
      </div>
      <button onclick="checkBingo()">
        🏆 CHECK BINGO
      </button>
    </div>
    <div class="card">
      <h3>Game Controls</h3>
      <button onclick="newGame()">
        🔄 NEW GAME
      </button>
      <button onclick="logout()">
        🚪 LOG OUT
      </button>
    </div>
  </div>
  <div class="small">
    ELUZA BINGO © 2026
  </div>
</div>
<p class="notice">Demo mode only. No real-money deposits or withdrawals are enabled.</p>
</section>
</main>

<script>
let numbers=[], called=new Set(), gameOver=false;
function shuffle(a){return a.sort(()=>Math.random()-0.5)}
function makeCard(){
  const cols=[];
  for(let c=0;c<5;c++){
    let start=c*15+1, arr=[];
    for(let n=start;n<start+15;n++)arr.push(n);
    cols.push(shuffle(arr).slice(0,5));
let balance = 100;
let calledNumbers = [];
function startGame() {
  const name = document.getElementById("playerName").value.trim();
  if (name === "") {
    alert("Please enter your player name.");
    return;
  }
  document.getElementById("loginBox").classList.add("hidden");
  document.getElementById("gameBox").classList.remove("hidden");
  document.getElementById("welcome").innerText =
    "Welcome, " + name + " 👋";
  document.getElementById("balance").innerText = balance;
}
function selectCell(cell) {
  if (cell.classList.contains("free")) {
    return;
  }
  numbers=[];
  for(let r=0;r<5;r++)for(let c=0;c<5;c++)numbers.push(cols[c][r]);
  numbers[12]="FREE";
}
function render(){
  const b=document.getElementById("board"); b.innerHTML="";
  ["B","I","N","G","O"].forEach(x=>{
    const d=document.createElement("div");d.className="cell head";d.textContent=x;b.appendChild(d);
  });
  numbers.forEach((n,i)=>{
    const d=document.createElement("div");d.className="cell";
    if(n==="FREE"){d.classList.add("free","marked");d.textContent="FREE";}
    else {d.textContent=n;d.onclick=()=>{if(called.has(n))d.classList.toggle("marked")}}
    b.appendChild(d);
  });
}
function newGame(){
  called.clear();gameOver=false;document.getElementById("ball").textContent="—";
  makeCard();render();
}
function callBall(){
  if(gameOver)return;
  const available=[];
  for(let i=1;i<=75;i++)if(!called.has(i))available.push(i);
  if(!available.length)return;
  const n=available[Math.floor(Math.random()*available.length)];
  called.add(n);document.getElementById("ball").textContent=n;
  document.querySelectorAll(".cell").forEach(d=>{if(d.textContent==n)d.classList.add("marked")});
  checkWin();
}
function checkWin(){
  const cells=[...document.querySelectorAll(".cell")].slice(5);
  for(let r=0;r<5;r++){
    if([0,1,2,3,4].every(c=>cells[r*5+c].classList.contains("marked")))return win();
  cell.classList.toggle("selected");
}
function callNumber() {
  if (calledNumbers.length >= 75) {
    document.getElementById("status").innerText =
      "All numbers have been called.";
    return;
  }
  for(let c=0;c<5;c++){
    if([0,1,2,3,4].every(r=>cells[r*5+c].classList.contains("marked")))return win();
  let number;
  do {
    number = Math.floor(Math.random() * 75) + 1;
  } while (calledNumbers.includes(number));
  calledNumbers.push(number);
  document.getElementById("calledNumber").innerText = number;
  document.getElementById("status").innerText =
    "Number " + number + " has been called!";
}
function checkBingo() {
  const selected = document.querySelectorAll(".cell.selected");
  if (selected.length >= 5) {
    document.getElementById("status").innerText =
      "🎉 BINGO! Congratulations!";
    alert("🎉 BINGO! Congratulations!");
  } else {
    document.getElementById("status").innerText =
      "Keep playing. You need more marked numbers.";
  }
  if([0,6,12,18,24].every(i=>cells[i].classList.contains("marked")))return win();
  if([4,8,12,16,20].every(i=>cells[i].classList.contains("marked")))return win();
}
function win(){gameOver=true;setTimeout(()=>alert("🎉 BINGO! Demo win!"),100)}
newGame();
function newGame() {
  calledNumbers = [];
  document.getElementById("calledNumber").innerText = "-";
  document.querySelectorAll(".cell.selected")
    .forEach(cell => cell.classList.remove("selected"));
  document.getElementById("status").innerText =
    "New game started!";
}
function logout() {
  document.getElementById("gameBox").classList.add("hidden");
  document.getElementById("loginBox").classList.remove("hidden");
  document.getElementById("playerName").value = "";
  calledNumbers = [];
}
</script>
</body>
</html>
